{
  "id": "./",
  "name": "RadioCheck · 影像临床思维平台",
  "short_name": "RadioCheck",
  "description": "输入影像与报告/指南，回答同时给出影像分区与文献段落；证据不足就降级或拒答。仅用于医学影像教学与研究。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./app.html#/ask",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f4fbfa",
  "theme_color": "#0b4f55",
  "categories": ["medical", "education", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "问答工作台",
      "short_name": "问答",
      "description": "影像上传、分区定位、双引用问答",
      "url": "./app.html#/ask",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "读片工作台",
      "short_name": "读片",
      "description": "影像 → 区域 → 文献溯源",
      "url": "./read/clinic.html",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "组卷自测",
      "short_name": "组卷",
      "description": "出卷、作答、成绩回流",
      "url": "./read/paper.html",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "分区图谱",
      "short_name": "图谱",
      "description": "按章节系统学解剖分区",
      "url": "./read/teach.html",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
