      ],
      "key_points": [
        { "id": "GL-PNE-01", "text": "影像出现新发实变或浸润影，是社区获得性肺炎的重要支持依据，但需结合临床症状与实验室检查。" },
        { "id": "GL-PNE-02", "text": "实变内出现支气管充气征，提示病变位于肺泡腔，支持肺泡性实变而非支气管阻塞。" },
        { "id": "GL-PNE-03", "text": "影像报告应描述病变的部位、范围与伴随征象，以便评估严重程度与疗效随访。" }
      ]
    },
    {
      "topic_id": "NODULE",
      "topic_cn": "肺结节 / 粟粒样结节",
      "match_keywords": ["结节", "粟粒", "结节病", "肉芽肿"],
      "sources": [
        { "name": "Fleischner Society 2017 肺结节管理指南", "type": "paraphrase" },
        { "name": "中国肺结节诊治专家共识（2018）", "type": "paraphrase" }
      ],
      "required_elements": [
        { "label": "大小", "keywords": ["mm", "厘米", "cm", "直径", "大小"] },
        { "label": "密度类型", "keywords": ["实性", "亚实性", "磨玻璃", "部分实性", "钙化"] },
        { "label": "边缘与形态", "keywords": ["光滑", "分叶", "毛刺", "边界", "形态"] },
        { "label": "分布", "keywords": ["单发", "多发", "双肺", "弥漫", "上叶", "下叶", "分布"] },
        { "label": "随访建议", "keywords": ["建议", "复查", "随访", "CT", "PET"] }
      ],
      "key_points": [
        { "id": "GL-NOD-01", "text": "结节报告应至少写明大小、密度类型与边缘特征，这三项直接决定后续随访策略。" },
        { "id": "GL-NOD-02", "text": "直径 6-8 mm 的实性结节，低危人群通常建议 6-12 个月复查胸部 CT。" },
        { "id": "GL-NOD-03", "text": "持续存在的纯磨玻璃结节需要按随访策略评估，不能仅凭单次影像判断性质。" }
      ]
    },
    {
      "topic_id": "EFFUSION",
