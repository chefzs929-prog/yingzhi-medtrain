      "required_elements": [
        { "label": "部位与侧别", "keywords": ["右", "左", "上野", "中野", "下野", "肺叶", "肺段"] },
        { "label": "范围", "keywords": ["大片", "斑片", "局限", "弥漫", "叶段", "多叶", "单叶"] },
        { "label": "密度与形态", "keywords": ["实变", "磨玻璃", "密度增高", "浸润", "气腔"] },
        { "label": "伴随征象", "keywords": ["支气管充气", "积液", "不张", "空洞", "钙化", "胸腔"] },
