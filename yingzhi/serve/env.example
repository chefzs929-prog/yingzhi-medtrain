# 模型接入配置模板
# 用法：cp yingzhi/serve/env.example yingzhi/serve/.env
#      然后填上 key，再用 yingzhi/serve/start.sh 启动。
# .env 已在 .gitignore 里，不会被提交。

# ── 第一阶段：只接纯文本模型 ─────────────────────────────
# 填这三项就够。留空 = 该模型不可用。
YZ_LLM_TEXT_BASE=https://api.deepseek.com/v1
YZ_LLM_TEXT_KEY=
YZ_LLM_TEXT_MODEL=deepseek-chat

# ── 第二阶段：再加视觉模型（现在不用填）──────────────────
# 填了之后，/api/ask 带 image 字段才会走视觉分支。
# YZ_LLM_VISION_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# YZ_LLM_VISION_KEY=
# YZ_LLM_VISION_MODEL=qwen3-vl-plus

# 单次请求超时（秒）。模型慢就调大，网络差也调大。
YZ_LLM_TIMEOUT=60
